# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Tercen requirement: the web build under /build/web must be committed.
# Pattern must un-ignore the /build/web directory itself (not /build/web/),
/build/*
!/build/web
# ...but not the canvaskit symbol maps. Nothing in the served bundle requests
# them (verified: no reference in any built .js/.html/.json); they exist only
# for offline stack-trace symbolication via `flutter symbolize`. Excluding them
# keeps ~8MB out of every GitHub zipball Tercen has to download.
/build/web/**/*.symbols
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Platform-specific directories (web-only project)
/android/
/ios/
/windows/
/linux/
/macos/

# Claude Code - local tooling and settings, never deployed
.claude/


# Temporary files
nul

# Specifications and design documents - kept in _local, not deployed
FLUTTER_TECHNICAL_SPECIFICATION.md
IMAGE_OVERVIEW_*.md
PTK_3project.zip

# Chat review and conversation transcripts
chat_review/

# Local reference materials, specs and dev utilities (not committed)
_local/

# Development-only scripts. Live in _local/dev-tools/ - they are debugging
# helpers, not part of the deployed operator.
/tool/
/tools/
